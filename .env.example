# Postgres (local). When set, the app uses it instead of dsamixer.db.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dsamixer

# Copy to .env and fill in. Use a personal Gmail with an App Password:
# https://support.google.com/accounts/answer/185833
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_TO=you@gmail.com
APP_URL=http://127.0.0.1:8765

# Weekly AI planner (AI course tab): set ONE of these.
# OpenRouter is used when its key is present (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model that supports structured outputs:
OPENROUTER_MODEL=openai/gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
